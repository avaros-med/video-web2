# Copy to .env for local development (.env and .env.production are gitignored).
#
# The room page for ehr's video visits (ehr docs/schedule-video.md): served at
# {REACT_APP_BASE_HREF}/room/{room}. Locally https://localhost:3003/av/video2-mysql/room/{room};
# on test and in production /av/video2-mysql/room/{room}, its assets under /av/static/video2-mysql.

PORT=3003
HTTPS=true
# A certificate the browser trusts, so Chrome does not warn about the page (mkcert; CLAUDE.md,
# "Environment"). Without these the dev server makes its own, and Chrome asks to proceed.
# SSL_CRT_FILE=.cert/localhost.pem
# SSL_KEY_FILE=.cert/localhost-key.pem
# Test and production builds: PUBLIC_URL=/av/static/video2-mysql. Leave it unset locally.
# PUBLIC_URL=/av/static/video2-mysql
REACT_APP_BASE_HREF=/av/video2-mysql

# Each room's ehr is worked out from the room's name ({clinic}_...) and the page's host
# (src/services/http/ehr.ts): http://localhost:3000 when developing. To point a local page
# at another ehr, e.g. a test clinic's, set this; production builds ignore it.
# REACT_APP_EHR_URL=https://{clinic}.test.avaros.ca

# Twilio Video: peer-to-peer rooms, as ark's.
REACT_APP_ROOM_TYPE=peer-to-peer

# Twilio Conversations is not used: the chat goes through ehr's room stream.
REACT_APP_DISABLE_TWILIO_CONVERSATIONS=true
REACT_APP_CHAT_DISABLED_BY_DEFAULT=false
REACT_APP_ENABLE_BACKGROUND_BLUR=true

# End-to-end tests (npm run test:e2e) sign in to the local OSCAR. Put these in
# .env.local (gitignored), never here: OSCAR_USERNAME, OSCAR_PASSWORD, OSCAR_PIN, and the
# patient the suite books its visits for, E2E_DEMOGRAPHIC_NO. Optional: E2E_UI_URL,
# E2E_EHR_URL, E2E_OSCAR_URL, E2E_PROVIDER_ID (default: the signed-in provider).
